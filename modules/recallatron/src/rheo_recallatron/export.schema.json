{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rheo.stream/schemas/recallatron/export/v1.json",
  "title": "Recallatron export format v1",
  "description": "One line of the module's export category. Every line is an object carrying a 'record' discriminator naming the table it came from; the core collector validates each line of the file against this document before it reaches the archive, and again before it reaches the importer. Embeddings are absent by design: they are rebuildable, and 1a2 owns rebuilding them. So is search_tsv, which is a generated column and is regenerated by the DDL rather than transported.",
  "type": "object",
  "required": ["record"],
  "properties": {
    "record": {
      "enum": [
        "memory",
        "memory_purpose",
        "memory_entity",
        "memory_mention",
        "memory_link",
        "source_receipt"
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "nullableUuid": {
      "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
    },
    "timestamp": { "type": "string", "minLength": 20 },
    "nullableTimestamp": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "nullableText": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },
    "purpose": {
      "enum": [
        "respond",
        "follow_up",
        "share_with_referral",
        "internal_analysis"
      ]
    },
    "audienceKind": { "enum": ["workspace", "member"] }
  },
  "allOf": [
    {
      "if": { "properties": { "record": { "const": "memory" } } },
      "then": {
        "additionalProperties": false,
        "required": [
          "record",
          "id",
          "kind",
          "title",
          "body",
          "audience_kind",
          "audience_id",
          "confidence",
          "occurred_at",
          "recorded_at",
          "recorded_by_kind",
          "recorded_by_id",
          "origin",
          "revision",
          "corrected_at",
          "superseded_by_id",
          "invalidated_at",
          "invalidation_reason",
          "source_namespace",
          "external_source_key"
        ],
        "properties": {
          "record": { "const": "memory" },
          "id": { "$ref": "#/$defs/uuid" },
          "kind": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "body": { "type": "string", "minLength": 1 },
          "audience_kind": { "$ref": "#/$defs/audienceKind" },
          "audience_id": { "$ref": "#/$defs/nullableUuid" },
          "confidence": {
            "oneOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "occurred_at": { "$ref": "#/$defs/nullableTimestamp" },
          "recorded_at": { "$ref": "#/$defs/timestamp" },
          "recorded_by_kind": { "type": "string", "minLength": 1 },
          "recorded_by_id": { "$ref": "#/$defs/nullableUuid" },
          "origin": { "enum": ["told", "derived", "migrated"] },
          "revision": { "type": "integer", "minimum": 1 },
          "corrected_at": { "$ref": "#/$defs/nullableTimestamp" },
          "superseded_by_id": { "$ref": "#/$defs/nullableUuid" },
          "invalidated_at": { "$ref": "#/$defs/nullableTimestamp" },
          "invalidation_reason": {
            "oneOf": [
              {
                "enum": [
                  "source_deleted",
                  "source_corrected",
                  "source_superseded"
                ]
              },
              { "type": "null" }
            ]
          },
          "source_namespace": { "$ref": "#/$defs/nullableText" },
          "external_source_key": { "$ref": "#/$defs/nullableText" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "memory_purpose" } } },
      "then": {
        "additionalProperties": false,
        "required": ["record", "memory_id", "purpose"],
        "properties": {
          "record": { "const": "memory_purpose" },
          "memory_id": { "$ref": "#/$defs/uuid" },
          "purpose": { "$ref": "#/$defs/purpose" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "memory_entity" } } },
      "then": {
        "additionalProperties": false,
        "required": [
          "record",
          "id",
          "kind",
          "name",
          "normalized_name",
          "ref",
          "created_at",
          "source_namespace",
          "external_source_key"
        ],
        "properties": {
          "record": { "const": "memory_entity" },
          "id": { "$ref": "#/$defs/uuid" },
          "kind": {
            "enum": [
              "person",
              "organization",
              "project",
              "topic",
              "place",
              "thing"
            ]
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "normalized_name": { "type": "string", "minLength": 1 },
          "ref": { "$ref": "#/$defs/nullableText" },
          "created_at": { "$ref": "#/$defs/timestamp" },
          "source_namespace": { "$ref": "#/$defs/nullableText" },
          "external_source_key": { "$ref": "#/$defs/nullableText" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "memory_mention" } } },
      "then": {
        "additionalProperties": false,
        "required": ["record", "memory_id", "entity_id", "role"],
        "properties": {
          "record": { "const": "memory_mention" },
          "memory_id": { "$ref": "#/$defs/uuid" },
          "entity_id": { "$ref": "#/$defs/uuid" },
          "role": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 100 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "memory_link" } } },
      "then": {
        "additionalProperties": false,
        "required": [
          "record",
          "memory_id",
          "ref",
          "relation",
          "created_at",
          "supersession_lineage"
        ],
        "properties": {
          "record": { "const": "memory_link" },
          "memory_id": { "$ref": "#/$defs/uuid" },
          "ref": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["derived_from", "about"] },
          "created_at": { "$ref": "#/$defs/timestamp" },
          "supersession_lineage": { "type": "boolean" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "source_receipt" } } },
      "then": {
        "additionalProperties": false,
        "required": [
          "record",
          "representation_type",
          "source_namespace",
          "external_source_key",
          "record_id",
          "payload_digest",
          "state",
          "producer_kind",
          "authority_id",
          "principal_account_id",
          "audience_kind",
          "audience_id",
          "bound_purpose",
          "source_recorded_at",
          "source_expires_at"
        ],
        "properties": {
          "record": { "const": "source_receipt" },
          "representation_type": { "enum": ["memory", "entity"] },
          "source_namespace": { "type": "string", "minLength": 1 },
          "external_source_key": { "type": "string", "minLength": 1 },
          "record_id": { "$ref": "#/$defs/nullableUuid" },
          "payload_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "enum": [
              "active",
              "noop",
              "denied",
              "erased",
              "expired",
              "orphaned"
            ]
          },
          "producer_kind": {
            "enum": ["migration", "rheo_runtime", "claude_code_local"]
          },
          "authority_id": { "$ref": "#/$defs/uuid" },
          "principal_account_id": { "$ref": "#/$defs/nullableUuid" },
          "audience_kind": { "$ref": "#/$defs/audienceKind" },
          "audience_id": { "$ref": "#/$defs/nullableUuid" },
          "bound_purpose": {
            "oneOf": [{ "$ref": "#/$defs/purpose" }, { "type": "null" }]
          },
          "source_recorded_at": { "$ref": "#/$defs/nullableTimestamp" },
          "source_expires_at": { "$ref": "#/$defs/nullableTimestamp" }
        }
      }
    }
  ]
}
