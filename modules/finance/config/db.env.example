# The keys of $FINANCE_DATA_DIR/db.env (default ~/Finances/db.env), mode 0600. The
# module reads them until its wiring switches every connection to core's workspace
# connection and a role. Never commit live values.
#
# FINANCE_OWNER_DSN   postgresql://finance_owner:<password>@<host>:<port>/<database>
# FINANCE_READER_DSN  postgresql://finance_reader:<password>@<host>:<port>/<database>
FINANCE_OWNER_DSN=
FINANCE_READER_DSN=
