RHEO_CORE_INTERNAL_URL=http://localhost:8000

# The internal listener (port 8100, C7b/C10) is container-network only —
# compose never publishes it, so this resolves to anything only when the web
# tier itself runs on that network (a real deployment; not `make demo`, which
# runs web with `next start` on the host and deliberately leaves this unset —
# see 10's own note on `RHEO_CORE_INTERNAL_API_URL` in `lib/routing/load.ts`).
# NOT RHEO_CORE_INTERNAL_URL above: that variable is 0a's, for the *public*
# listener on 8000, and stays pointed there for page.tsx's /healthz read.
RHEO_CORE_INTERNAL_API_URL=http://localhost:8100
# The shared secret every internal-listener request presents in
# X-Rheo-Internal; the listener refuses before either endpoint runs without a
# match. The same dev-only placeholder deploy/compose.yaml bakes into `core`.
RHEO_INTERNAL_SECRET=rheo_dev_only_internal_secret

# An operator's own GitHub OAuth app credentials (identity.providers.github).
# Empty placeholders: this repo has none checked in. Register the app's
# callback URL as `rheo routing hosts`' last line prints it (composed from
# routing.public_host, which inherits the port-free routing.base_host unless
# you set a non-default public port), then fill these
# in and set identity.providers.github.enabled=true (deploy/README.md).
RHEO_GITHUB_CLIENT_ID=
RHEO_GITHUB_CLIENT_SECRET=
# Empty placeholder for runtime.claude_cli when credential_kind=api_key
# (secret://env/RHEO_ANTHROPIC_API_KEY). This repo has none checked in.
RHEO_ANTHROPIC_API_KEY=

# Selects which fixture file (tests/fixtures/routing/{path,subdomain}-mode.json)
# apps/web's own vitest suite loads (10's vitest.config.ts; 06's/11's CI steps
# run the suite once per value). Nothing at runtime reads this — no code under
# apps/core or apps/web's server paths resolves it — so it is a test-only
# selector, not a deployment knob to set for a running instance.
RHEO_ROUTING_MODE=path

# Host ports for the compose Postgres and core, and for `make demo`'s web
# check (make demo runs the web shell directly with `next start`, outside
# compose). Override any of these only if the default is already bound by
# another project on your machine — nothing on the compose network reads them,
# only the host-side publish moves.
RHEO_PG_PORT=5432
RHEO_CORE_PORT=8000
RHEO_WEB_PORT=3000
RHEO_CLUSTER_DSN=postgresql://rheo:rheo_dev_only@localhost:5432/postgres
RHEO_TEST_CLUSTER_DSN=postgresql://rheo:rheo_dev_only@localhost:5432/postgres

# The in-image default (deploy/README.md § the data-root volume) — right for
# `core`'s container, wrong for a host-side `rheo` command, which needs its own
# path (e.g. an absolute path outside the checkout, or the in-checkout
# .rheo-local/ opt-in) or it will try to create /var/lib/rheo-stream on the host.
RHEO_DATA_ROOT=/var/lib/rheo-stream
RHEO_PROFILE=development

# `core`'s PUBLIC listener (8000), as a server-side forward target, read by
# `apps/web`'s `corePublicBaseUrl()`. A Next route handler that forwards to the
# shipped `POST /auth/session/workspace` is its only kind of caller. Not
# interchangeable with either variable above: RHEO_CORE_INTERNAL_URL is the public
# listener's /healthz for the shell's own page, and RHEO_CORE_INTERNAL_API_URL is
# the internal listener. Spelled `localhost` and never `127.0.0.1`: the forwarded
# request's Host header is this URL's own authority and the session secret is
# host-bound, so a secret minted for `localhost` would be refused
# `session_missing` under `127.0.0.1`. No Makefile target sets it.
RHEO_CORE_PUBLIC_URL=http://localhost:8000

# The module allowlist: a comma-separated list of module ids that `load_modules()`
# is permitted to load. **Empty by default, and that empty default is the whole
# point** — a distribution that is installed and whose `rheo.modules` entry point
# is discoverable still registers nothing at all unless it is named here, so
# discovery never activates anything. No distribution in the checkout publishes
# such an entry point today, so nothing is discoverable to name. It goes when the
# real `modules.installed` settings key lands.
#
# The marker below is that paragraph, made machine-readable: preflight otherwise
# fails a present-but-empty key, so a correct phase-1 configuration could not
# pass. It permits emptiness for this one key; a non-empty value is still
# placeholder-checked.
# preflight: allow-empty
RHEO_MODULES=

# None of the above is read automatically: `make` sources no .env file, and
# `docker compose` only auto-loads one from deploy/ (next to compose.yaml), not
# from this file's location. Copy this to `.env` and `set -a; . ./.env; set +a`
# (or otherwise export every value) before `make up`/`make demo`/`uv run rheo`.
