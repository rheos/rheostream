# Every variable deploy/compose.flagship.yaml interpolates. Placeholders only — no
# real secret, host, IP, UUID or network id belongs here; this file is committed.
# Follow .env.example's comment style. Every value below is non-empty on purpose:
# each is required (`${VAR:?}` in the overlay), so `make flagship-config` — which
# runs against this exact file — would fail loudly on an empty one the same way
# Coolify would on a missing one; that failure mode is what AC-4 wants, exercised
# here rather than only asserted in the overlay test.

# The application's public host. Every Traefik router below is built from this —
# never the literal `rheo.stream`.
RHEO_BASE_HOST=rheo.stream

# openssl rand -hex 32 — hex so it sits in the Postgres DSN unescaped (no
# URL-escaping needed for a pure hex string). Placeholder below is NOT hex-shaped
# on purpose, so it can never be mistaken for a real generated value.
RHEO_PG_PASSWORD=CHANGE_ME_run_openssl_rand_hex_32

# openssl rand -hex 32 — the shared secret the internal listener requires on every
# internal-network request (X-Rheo-Internal).
RHEO_INTERNAL_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# First deploy runs with GitHub sign-in disabled until the owner's account is
# pre-created on the box, then this flips to true.
RHEO_GITHUB_ENABLED=false
RHEO_GITHUB_CLIENT_ID=CHANGE_ME_github_oauth_app_client_id
RHEO_GITHUB_CLIENT_SECRET=CHANGE_ME_github_oauth_app_client_secret

# Must name a DNS-01 resolver defined on the operator's own reverse-proxy config;
# this file defines none. Placeholder only.
RHEO_TLS_CERTRESOLVER=letsencrypt-dns

# The Docker network the deploy platform creates for this application and attaches
# its proxy to (Coolify: the Application resource's own uuid). Placeholder only —
# filled in once the Application exists.
RHEO_TRAEFIK_NETWORK=CHANGE_ME_coolify_application_network_name
